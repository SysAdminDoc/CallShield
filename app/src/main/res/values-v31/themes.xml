<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CallShield" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">#F5F6F7</item>
        <item name="android:statusBarColor">#F5F6F7</item>
        <item name="android:navigationBarColor">#F5F6F7</item>
        <item name="android:windowBackground">#F5F6F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 12+ Splash Screen -->
        <item name="android:windowSplashScreenBackground">#F5F6F7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="Theme.CallShield.Light">
        <item name="android:windowSplashScreenBackground">#F5F6F7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="Theme.CallShield.Graphite">
        <item name="android:windowSplashScreenBackground">#0F1216</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="Theme.CallShield.Amoled">
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules (android:dataExtractionRules).
     Mirrors backup_rules.xml: preserve user data (database + public
     DataStore) without transferring operational files, downloaded model/feed
     artifacts, or no-backup private DataStore secrets. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>

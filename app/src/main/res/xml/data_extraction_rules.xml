<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules (android:dataExtractionRules).
     Cloud backup preserves settings but excludes the sensitive Room database.
     Direct device-to-device transfer keeps both because data stays in the
     user's local migration flow. Operational files and private no-backup
     preferences remain excluded from both paths. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>

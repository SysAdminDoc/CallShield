<?xml version="1.0" encoding="utf-8"?>
<!-- API 23-30 backup rules (android:fullBackupContent).
     Cloud backup preserves non-secret user settings only. The Room database
     can contain call history, phone numbers, and raw SMS bodies, so users must
     opt in explicitly through CallShield's portable backup flow instead of
     having that data uploaded automatically. Private preferences live under
     noBackupFilesDir and are never included. -->
<full-backup-content>
    <include domain="file" path="datastore/" />
</full-backup-content>
